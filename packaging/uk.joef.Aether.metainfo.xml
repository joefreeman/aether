<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream upstream metadata: what software centers show for the app. Shipped in the AppImage
     at usr/share/metainfo/ (renamed to the legacy `.appdata.xml` suffix there — the only one
     appimagetool recognizes). This file is a template — @VERSION@ and @DATE@ are rendered by the
     release workflow from the tag-verified Cargo.toml version, so the release entry can never
     drift from the published binary. Screenshots are deliberately omitted (validator warning,
     not an error); add them if this ever goes to a software-center catalogue like Flathub. -->
<component type="desktop-application">
  <id>uk.joef.Aether</id>
  <name>Aether</name>
  <summary>Modal text editor</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      Aether is an experimental modal text editor with a client–server architecture and
      tree-sitter integration. A long-lived local server holds all text state — buffer contents,
      cursors, selections, the undo stack — while thin clients render what the server sends and
      forward keystrokes. Multiple clients can share a buffer, see each other's cursors, and
      share a single undo stack.
    </p>
    <ul>
      <li>Modal editing with tree-sitter highlighting, indentation, and navigation</li>
      <li>Fuzzy pickers for files, buffers, and workspaces; file explorer; workspace-wide grep</li>
      <li>Git integration: gutter, inline diff, blame, hunk staging</li>
      <li>LSP support: diagnostics, hover, go-to-definition, formatting</li>
      <li>Terminal, desktop, and web clients</li>
    </ul>
  </description>
  <launchable type="desktop-id">uk.joef.Aether.desktop</launchable>
  <!-- Mirrors the desktop entry's MimeType= line: software centres read the media types from here,
       file managers read them from there, and the two drifting apart is how an app ends up
       advertised for formats it doesn't open. Keep them in step. -->
  <provides>
    <binary>ae</binary>
    <mediatype>text/plain</mediatype>
    <mediatype>text/markdown</mediatype>
    <mediatype>text/rust</mediatype>
    <mediatype>text/html</mediatype>
    <mediatype>text/css</mediatype>
    <mediatype>text/javascript</mediatype>
    <mediatype>text/x-python</mediatype>
    <mediatype>text/x-go</mediatype>
    <mediatype>text/x-elixir</mediatype>
    <mediatype>text/x-erlang</mediatype>
    <mediatype>application/json</mediatype>
    <mediatype>application/toml</mediatype>
    <mediatype>application/yaml</mediatype>
    <mediatype>application/sql</mediatype>
    <mediatype>application/x-shellscript</mediatype>
    <mediatype>inode/directory</mediatype>
  </provides>
  <url type="homepage">https://github.com/joefreeman/aether</url>
  <url type="vcs-browser">https://github.com/joefreeman/aether</url>
  <developer id="uk.joef">
    <name>Joe Freeman</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
